{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["serviceAccount", "secrets", "database", "nats", "config", "server", "worker", "service", "workerService", "ingress", "podDisruptionBudget", "networkPolicy", "demoDependencies"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "serviceAccount": {"$ref": "#/$defs/serviceAccount"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "masterKeyKey", "bootstrapAPIKeyKey"],
      "properties": {
        "existingSecret": {"type": "string"},
        "masterKeyKey": {"type": "string", "minLength": 1},
        "bootstrapAPIKeyKey": {"type": "string", "minLength": 1}
      }
    },
    "database": {"$ref": "#/$defs/connection"},
    "nats": {"$ref": "#/$defs/connection"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicBaseURL", "defaultTenantID", "workerConcurrency", "runbookConcurrency", "eventMaxDeliveries", "eventRetryBaseDelay", "eventRetryMaxDelay", "runbookHTTPAllowedHosts", "pluginAllowedHosts", "allowUnauthenticatedSources", "otlpTraceEndpoint", "traceSampleRatio", "traceExportTimeout", "extraEnv"],
      "properties": {
        "publicBaseURL": {"type": "string", "pattern": "^https?://"},
        "defaultTenantID": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
        "workerConcurrency": {"type": "integer", "minimum": 1, "maximum": 128},
        "runbookConcurrency": {"type": "integer", "minimum": 1, "maximum": 64},
        "eventMaxDeliveries": {"type": "integer", "minimum": 2, "maximum": 100},
        "eventRetryBaseDelay": {"type": "string", "minLength": 2},
        "eventRetryMaxDelay": {"type": "string", "minLength": 2},
        "runbookHTTPAllowedHosts": {"type": "string"},
        "pluginAllowedHosts": {"type": "string"},
        "allowUnauthenticatedSources": {"type": "boolean"},
        "otlpTraceEndpoint": {"type": "string"},
        "traceSampleRatio": {"type": "number", "minimum": 0, "maximum": 1},
        "traceExportTimeout": {"type": "string", "minLength": 2},
        "extraEnv": {"type": "array", "items": {"type": "object"}}
      }
    },
    "server": {"$ref": "#/$defs/workload"},
    "worker": {"$ref": "#/$defs/workload"},
    "service": {"$ref": "#/$defs/service"},
    "workerService": {
      "allOf": [
        {"$ref": "#/$defs/service"},
        {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "hosts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["host", "paths"], "properties": {"host": {"type": "string", "minLength": 1}, "paths": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "pathType"], "properties": {"path": {"type": "string", "minLength": 1}, "pathType": {"enum": ["Exact", "Prefix", "ImplementationSpecific"]}}}}}},
        "tls": {"type": "array", "items": {"type": "object"}}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "worker"],
      "properties": {
        "server": {"$ref": "#/$defs/pdb"},
        "worker": {"$ref": "#/$defs/pdb"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowDNS", "allowSameNamespaceEgress", "ingressNamespaceSelector", "ingressPodSelector", "additionalEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowDNS": {"type": "boolean"},
        "allowSameNamespaceEgress": {"type": "boolean"},
        "ingressNamespaceSelector": {"type": "object"},
        "ingressPodSelector": {"type": "object"},
        "additionalEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "demoDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingSecret", "postgres", "nats"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "postgres": {"$ref": "#/$defs/postgresDemo"},
        "nats": {"$ref": "#/$defs/natsDemo"}
      }
    }
  },
  "$defs": {
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "automountServiceAccountToken"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "automountServiceAccountToken": {"type": "boolean"}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "existingSecret", "urlKey"],
      "properties": {
        "url": {"type": "string"},
        "existingSecret": {"type": "string"},
        "urlKey": {"type": "string", "minLength": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "podAnnotations", "podLabels", "priorityClassName", "resources", "podSecurityContext", "containerSecurityContext", "nodeSelector", "tolerations", "affinity", "topologySpreadConstraints", "terminationGracePeriodSeconds"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/$defs/image"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "priorityClassName": {"type": "string"},
        "resources": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "containerSecurityContext": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+%$"}]}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass"],
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"type": "string", "minLength": 2},
        "storageClass": {"type": "string"}
      }
    },
    "postgresDemo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "usernameKey", "passwordKey", "databaseKey", "persistence", "resources"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "usernameKey": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1},
        "databaseKey": {"type": "string", "minLength": 1},
        "persistence": {"$ref": "#/$defs/persistence"},
        "resources": {"type": "object"}
      }
    },
    "natsDemo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "persistence", "resources"],
      "properties": {
        "image": {"$ref": "#/$defs/image"},
        "persistence": {"$ref": "#/$defs/persistence"},
        "resources": {"type": "object"}
      }
    }
  }
}
