{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stormrelay.dev/schemas/benchmark-result-v1.json",
  "title": "StormRelay benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit_sha",
    "profile",
    "environment",
    "configuration",
    "phase",
    "metrics",
    "go_benchmarks",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stormrelay.benchmark-result/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "os", "runtimes"],
      "properties": {
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_model", "logical_cpus", "memory_bytes"],
          "properties": {
            "cpu_model": {"type": "string", "minLength": 1},
            "logical_cpus": {"type": "integer", "minimum": 1},
            "memory_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "architecture"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1}
          }
        },
        "runtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go", "docker", "docker_compose", "k6", "postgres", "nats"],
          "properties": {
            "go": {"type": "string", "minLength": 1},
            "docker": {"type": "string", "minLength": 1},
            "docker_compose": {"type": "string", "minLength": 1},
            "k6": {"type": "string", "minLength": 1},
            "postgres": {"type": "string", "minLength": 1},
            "nats": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "database_target", "nats_target"],
      "properties": {
        "base_url": {"type": "string", "minLength": 1},
        "database_target": {"type": "string", "minLength": 1},
        "nats_target": {"type": "string", "minLength": 1}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold_start", "cache_state", "warmup_seconds", "measurement_seconds"],
      "properties": {
        "cold_start": {"type": "boolean"},
        "cache_state": {"enum": ["cold", "warmed"]},
        "warmup_seconds": {"type": "number", "minimum": 0},
        "measurement_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_acceptance_ms",
        "event_to_incident_ms",
        "error_rate",
        "accepted_events",
        "durable_events",
        "duplicate_requests"
      ],
      "properties": {
        "http_acceptance_ms": {"$ref": "#/$defs/latencyMetric"},
        "event_to_incident_ms": {"$ref": "#/$defs/latencyMetric"},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "accepted_events": {"type": "integer", "minimum": 0},
        "durable_events": {"type": "integer", "minimum": 0},
        "duplicate_requests": {"type": "integer", "minimum": 0}
      }
    },
    "go_benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "iterations", "nanoseconds_per_operation"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "iterations": {"type": "integer", "minimum": 1},
          "nanoseconds_per_operation": {"type": "number", "minimum": 0},
          "bytes_per_operation": {"type": "number", "minimum": 0},
          "allocations_per_operation": {"type": "number", "minimum": 0},
          "megabytes_per_second": {"type": "number", "minimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "profile_path", "k6_summary_path", "go_benchmark_path", "git_dirty"],
      "properties": {
        "generated_by": {"const": "tests/load/capture_result.py"},
        "profile_path": {"type": "string", "minLength": 1},
        "k6_summary_path": {"type": "string", "minLength": 1},
        "go_benchmark_path": {"type": "string", "minLength": 1},
        "git_dirty": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "latencyMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "samples", "p50", "p95", "p99"],
      "properties": {
        "unit": {"const": "ms"},
        "samples": {"type": "integer", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "description", "dataset", "concurrency", "timing", "go_benchmark", "dependencies"],
      "properties": {
        "schema_version": {"const": "stormrelay.benchmark-profile/v1"},
        "name": {"enum": ["correctness", "full"]},
        "description": {"type": "string", "minLength": 1},
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_shape", "tenant_count", "source_count", "payload_bytes", "duplicate_ratio", "service_cardinality", "environment", "severity"],
          "properties": {
            "event_shape": {"enum": ["generic-json"]},
            "tenant_count": {"type": "integer", "minimum": 1},
            "source_count": {"type": "integer", "minimum": 1},
            "payload_bytes": {"type": "integer", "minimum": 128},
            "duplicate_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "service_cardinality": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "severity": {"enum": ["info", "warning", "error", "critical"]}
          }
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["virtual_users", "max_virtual_users"],
          "properties": {
            "virtual_users": {"type": "integer", "minimum": 1},
            "max_virtual_users": {"type": "integer", "minimum": 1}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warmup_seconds", "duration_seconds", "incident_timeout_seconds", "poll_interval_milliseconds"],
          "properties": {
            "warmup_seconds": {"type": "number", "minimum": 0},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "incident_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "poll_interval_milliseconds": {"type": "integer", "minimum": 10}
          }
        },
        "go_benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["benchtime", "count"],
          "properties": {
            "benchtime": {"type": "string", "minLength": 2},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgres_image", "postgres_max_connections", "nats_image", "jetstream_storage", "k6_image"],
          "properties": {
            "postgres_image": {"type": "string", "minLength": 1},
            "postgres_max_connections": {"type": "integer", "minimum": 1},
            "nats_image": {"type": "string", "minLength": 1},
            "jetstream_storage": {"enum": ["file", "memory"]},
            "k6_image": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
