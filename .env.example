STORMRELAY_DATABASE_URL=postgres://stormrelay:stormrelay@localhost:5432/stormrelay?sslmode=disable
STORMRELAY_NATS_URL=nats://localhost:4222
STORMRELAY_MASTER_KEY=replace-with-base64-encoded-32-byte-key
STORMRELAY_BOOTSTRAP_API_KEY=replace-with-random-development-key
STORMRELAY_PUBLIC_BASE_URL=http://localhost:8080
STORMRELAY_RUNBOOK_CONCURRENCY=4
STORMRELAY_RUNBOOK_HTTP_ALLOWED_HOSTS=automation.example.net
STORMRELAY_PLUGIN_ALLOWED_HOSTS=plugin.example.net

# Optional OTLP/gRPC distributed tracing. Leave the endpoint empty to disable export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
STORMRELAY_OTEL_TRACE_SAMPLE_RATIO=0.10
STORMRELAY_OTEL_EXPORT_TIMEOUT=10s
